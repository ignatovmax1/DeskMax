<Window x:Class="DeskMax.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskMax — удалённый доступ" Width="1180" Height="820" MinWidth="840" MinHeight="600" Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
 <Window.Resources>

  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="Padding" Value="16,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="24"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SidebarText}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,3"/><Setter Property="Padding" Value="14,12"/><Setter Property="FontSize" Value="14"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="226"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" Padding="22,28"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock Text="deskmax" Foreground="{DynamicResource SidebarText}" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="УДАЛЁННАЯ РАБОТА" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="0,5,0,30"/><Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,18"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="VersionText" Foreground="{DynamicResource SidebarMuted}" Margin="0,0,0,10"/><Button x:Name="UpdateButton" Content="Проверить обновления" Click="CheckUpdates_Click" Background="{DynamicResource SidebarButton}" Padding="10,11" FontSize="12"/></StackPanel><StackPanel><Button x:Name="HomeNav" Style="{StaticResource Nav}" Content="⌂   Обзор" Tag="Home" Click="Navigate_Click"/><Button x:Name="RequestsNav" Style="{StaticResource Nav}" Content="▤   Запросы доступа" Tag="Requests" Click="Navigate_Click"/><Button x:Name="HistoryNav" Style="{StaticResource Nav}" Content="◷   Журнал" Tag="History" Click="Navigate_Click"/><Button x:Name="SettingsNav" Style="{StaticResource Nav}" Content="⚙   Настройки" Tag="Settings" Click="Navigate_Click"/></StackPanel></DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="34,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="{DynamicResource OnlineBackground}" CornerRadius="8" Padding="13,9" VerticalAlignment="Top"><TextBlock x:Name="OnlineText" Text="Подключаемся…" FontSize="12"/></Border><StackPanel><TextBlock x:Name="PageTitle" Text="Ваш рабочий стол. Рядом." FontSize="30" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Подключайтесь к близким устройствам — каждый сеанс начинается с разрешения владельца." Foreground="{DynamicResource TextMuted}" Margin="0,7,20,0"/></StackPanel></DockPanel>
   <Border x:Name="StatusBanner" Grid.Row="1" Background="{DynamicResource StatusBackground}" CornerRadius="8" Padding="14" Margin="0,20,0,20"><DockPanel><Button x:Name="ReconnectButton" Content="Повторить" Click="Reconnect_Click" Padding="11,6" Margin="12,0,0,0" DockPanel.Dock="Right" Visibility="Collapsed"/><TextBlock x:Name="Status" Text="Подключаемся к серверу…" Foreground="{DynamicResource StatusText}" VerticalAlignment="Center"/></DockPanel></Border>
   <Grid x:Name="HomePage" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><DockPanel><Border DockPanel.Dock="Left" Background="{DynamicResource OnlineBackground}" CornerRadius="5" Padding="8,5"><TextBlock Text="ЭТО УСТРОЙСТВО" Foreground="{DynamicResource TextMuted}" FontSize="10"/></Border><TextBlock x:Name="HostStatusText" Text="Ожидает подключения" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="DeviceNameText" FontSize="21" FontWeight="SemiBold" Margin="0,18,0,22"/><TextBlock Text="ВАШ ID" Foreground="{DynamicResource TextMuted}" FontSize="11"/><DockPanel Margin="0,4,0,10"><TextBlock x:Name="DeviceIdText" Text="—" FontSize="32" FontWeight="SemiBold"/><Button x:Name="CopyButton" Content="Копировать" IsEnabled="False" Click="CopyId_Click" Background="{DynamicResource SecondaryButton}" Foreground="{DynamicResource Accent}" Padding="11,8" Margin="12,0,0,0"/></DockPanel><Border Height="1" Background="{DynamicResource Divider}" Margin="0,19"/><DockPanel><TextBlock Text="КОД ДЛЯ ПОДКЛЮЧЕНИЯ" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock x:Name="ExpiryText" Text="После регистрации" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel><TextBlock x:Name="RotatingCodeText" Text="— — —" FontSize="37" FontWeight="SemiBold" FontFamily="Consolas" Margin="0,8,0,0"/><TextBlock Text="Передайте код только тому, кому доверяете. Каждый запрос вы подтверждаете отдельно." Foreground="{DynamicResource TextMuted}" Margin="0,18,0,0" FontSize="13"/></StackPanel></Border>
    <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><Border Background="{DynamicResource SurfaceAlternate}" CornerRadius="5" Padding="8,5" HorizontalAlignment="Left"><TextBlock Text="НОВОЕ ПОДКЛЮЧЕНИЕ" Foreground="{DynamicResource TextMuted}" FontSize="10"/></Border><TextBlock Text="На какое устройство зайти?" FontSize="23" FontWeight="SemiBold" Margin="0,16,0,7"/><TextBlock Text="Введите код, который показывает владелец." Foreground="{DynamicResource TextMuted}" Margin="0,0,0,20"/><TextBlock Text="ШЕСТИЗНАЧНЫЙ КОД" Foreground="{DynamicResource TextMuted}" FontSize="11" Margin="0,0,0,6"/><TextBox x:Name="ConnectionCode" MaxLength="6" FontSize="25" FontFamily="Consolas" TextChanged="ConnectionCode_TextChanged" AutomationProperties.Name="Временный код другого устройства"/><Button x:Name="ConnectButton" Content="Запросить доступ  →" Click="Connect_Click" Margin="0,14,0,0" IsEnabled="False"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,16,0,0" Background="{DynamicResource SurfaceAlternate}"><StackPanel><TextBlock Text="Сначала — разрешение владельца" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="После подтверждения вы увидите экран и сможете управлять мышью и клавиатурой. Владелец может завершить сеанс в любой момент." Foreground="{DynamicResource TextMuted}" Margin="0,9,0,0" FontSize="13"/></StackPanel></Border></StackPanel>
   </Grid>
   <StackPanel x:Name="RequestsPage" Grid.Row="2" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Входящие запросы" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Разрешение открывает трансляцию экрана и управление мышью и клавиатурой." Foreground="{DynamicResource TextMuted}" Margin="0,8,0,16"/><ListBox x:Name="RequestsList" MinHeight="130" DisplayMemberPath="Label"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Разрешить" Tag="approve" Click="Respond_Click"/><Button Content="Отклонить" Tag="reject" Click="Respond_Click" Margin="12,0" Background="{DynamicResource SecondaryButton}" Foreground="{DynamicResource Accent}"/></StackPanel><TextBlock x:Name="RequestsEmpty" Text="Новых запросов нет" Foreground="{DynamicResource TextMuted}" Margin="0,15,0,0"/></StackPanel></Border></StackPanel>
   <Border x:Name="HistoryPage" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="События текущего запуска" FontSize="22" Margin="0,0,0,16"/><ListBox x:Name="HistoryList" MinHeight="240" BorderThickness="0"/></StackPanel></Border>
   <Border x:Name="SettingsPage" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top"><StackPanel><TextBlock Text="Внешний вид" FontSize="19" FontWeight="SemiBold"/><CheckBox x:Name="DarkThemeToggle" Content="Тёмная тема" Margin="0,12,0,26" Checked="Theme_Changed" Unchecked="Theme_Changed"/><Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,22"/><TextBlock Text="Подключение" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Адрес сервера DeskMax" Foreground="{DynamicResource TextMuted}" Margin="0,14,0,7"/><TextBox x:Name="ServerAddress" AutomationProperties.Name="Адрес сервера"/><Button x:Name="SaveButton" Content="Сохранить и подключиться" Click="SaveSettings_Click" Margin="0,14,0,0" HorizontalAlignment="Left"/><TextBlock Text="Соединение защищено HTTPS. При перезапуске сервера устройство автоматически зарегистрируется снова." Foreground="{DynamicResource TextMuted}" Margin="0,18,0,0" FontSize="13"/></StackPanel></Border>
  </Grid></ScrollViewer>
 </Grid>
</Window>
