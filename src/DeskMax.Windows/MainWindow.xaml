<Window x:Class="DeskMax.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskMax" Width="1120" Height="720" MinWidth="980" MinHeight="650" Background="#090E1A" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="Panel" Color="#121A2B"/><SolidColorBrush x:Key="Muted" Color="#91A0BA"/><SolidColorBrush x:Key="Accent" Color="#665CFF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F5F7FF"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#0A1120"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#2A3855"/><Setter Property="Padding" Value="15,12"/><Setter Property="FontSize" Value="18"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="#0D1423" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" Background="{StaticResource Accent}" CornerRadius="12"><TextBlock Text="D" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="DeskMax" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><StackPanel Grid.Row="1" Margin="0,40,0,0"><Button Content="Главная" HorizontalContentAlignment="Left"/><Button Content="Устройства" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,8"/><Button Content="Журнал доступа" HorizontalContentAlignment="Left" Background="Transparent"/><Button Content="Настройки" HorizontalContentAlignment="Left" Background="Transparent" Margin="0,8"/></StackPanel><StackPanel Grid.Row="2"><TextBlock Text="●  Защищённое соединение" Foreground="#54D6A3"/><TextBlock Text="Версия 0.1.0" Foreground="{StaticResource Muted}" Margin="0,8,0,12"/><Button x:Name="UpdateButton" Content="Проверить обновления" Background="#23304A" Click="CheckUpdates_Click"/></StackPanel></Grid></Border>
  <Grid Grid.Column="1" Margin="34"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><DockPanel><StackPanel><TextBlock Text="Удалённый доступ" FontSize="30" FontWeight="Bold"/><TextBlock Text="Подключайтесь только с разрешения владельца устройства." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel><Border DockPanel.Dock="Right" Background="#12392F" CornerRadius="16" Padding="14,7" VerticalAlignment="Center"><TextBlock Text="●  Онлайн" Foreground="#62E6B2"/></Border></DockPanel>
   <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource Panel}" CornerRadius="20" Padding="30"><StackPanel><TextBlock Text="Это устройство" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="Постоянный ID" Margin="0,30,0,7" Foreground="{StaticResource Muted}"/><DockPanel><TextBlock x:Name="DeviceIdText" Text="482 917" FontSize="42" FontWeight="Bold"/><Button DockPanel.Dock="Right" Content="Копировать" Background="#23304A" Click="CopyId_Click"/></DockPanel><Border Height="1" Background="#26334A" Margin="0,26"/><TextBlock Text="Временный код" Foreground="{StaticResource Muted}"/><TextBlock x:Name="RotatingCodeText" Text="731 284" FontSize="34" FontWeight="SemiBold" Margin="0,7"/><TextBlock Text="Обновится через 18:42" Foreground="#F1B45A"/><Border Background="#0A1120" CornerRadius="13" Padding="16" Margin="0,30,0,0"><StackPanel><TextBlock Text="Доступ контролируете вы" FontWeight="SemiBold"/><TextBlock Text="Обычный сеанс требует подтверждения. Доверенный доступ выдаётся отдельно и может быть отозван." TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel></Border></StackPanel></Border>
    <StackPanel Grid.Column="2"><Border Background="{StaticResource Panel}" CornerRadius="20" Padding="30"><StackPanel><TextBlock Text="Подключиться" FontSize="25" FontWeight="Bold"/><TextBlock Text="Введите временный код другого устройства" Foreground="{StaticResource Muted}" Margin="0,6,0,22"/><TextBox x:Name="ConnectionCode" MaxLength="6"/><Button Content="Запросить подключение" Margin="0,14,0,0" Click="Connect_Click"/><TextBlock x:Name="Status" Text="Ожидание кода" Foreground="{StaticResource Muted}" Margin="0,13,0,0" TextWrapping="Wrap"/></StackPanel></Border><Border Background="{StaticResource Panel}" CornerRadius="20" Padding="26" Margin="0,24,0,0"><StackPanel><DockPanel><TextBlock Text="Доверенные устройства" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="0" Foreground="{StaticResource Muted}" DockPanel.Dock="Right"/></DockPanel><TextBlock Text="Список пуст. Добавление доступно только после явного согласия владельца." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
