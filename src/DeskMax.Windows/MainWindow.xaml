<Window x:Class="DeskMax.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskMax — удалённый доступ" Width="1120" Height="780" MinWidth="920" MinHeight="640" Background="{DynamicResource AppBackground}" FontFamily="Segoe UI" Loaded="Window_Loaded" Closed="Window_Closed">
 <Window.Resources>

  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource AccentText}"/><Setter Property="Padding" Value="16,11"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="14"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.85"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource Focus}"/><Setter TargetName="Surface" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="16"/><Setter Property="Background" Value="{DynamicResource InputBackground}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/></Style>
  <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="26"/></Style>
  <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource SidebarText}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Margin" Value="0,4"/></Style>
 </Window.Resources>
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition/></Grid.ColumnDefinitions>
  <Border Background="{DynamicResource Sidebar}" Padding="22,30"><DockPanel LastChildFill="True"><StackPanel DockPanel.Dock="Top"><TextBlock Text="deskmax" Foreground="{DynamicResource SidebarText}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="РАБОТА НА РАССТОЯНИИ" Foreground="{DynamicResource SidebarMuted}" FontSize="10" Margin="0,6,0,35"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="VersionText" Foreground="{DynamicResource SidebarMuted}" Margin="0,0,0,12"/><Button x:Name="UpdateButton" Content="Проверить обновления" Click="CheckUpdates_Click" Background="{DynamicResource SidebarButton}" Padding="10,12" FontSize="12"/></StackPanel><StackPanel><Button Style="{StaticResource Nav}" Content="Обзор" Tag="Home" Click="Navigate_Click"/><Button Style="{StaticResource Nav}" Content="Запросы доступа" Tag="Requests" Click="Navigate_Click"/><Button Style="{StaticResource Nav}" Content="Журнал" Tag="History" Click="Navigate_Click"/><Button Style="{StaticResource Nav}" Content="Настройки" Tag="Settings" Click="Navigate_Click"/></StackPanel></DockPanel></Border>
  <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><Grid Margin="34,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
   <DockPanel LastChildFill="True"><Border DockPanel.Dock="Right" Background="{DynamicResource OnlineBackground}" CornerRadius="5" Padding="12,8" VerticalAlignment="Top"><TextBlock x:Name="OnlineText" Text="Не подключено" FontSize="12"/></Border><StackPanel><TextBlock x:Name="PageTitle" Text="Ваш рабочий стол. Рядом." FontSize="29" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="Доступ к устройствам с разрешения их владельцев." Foreground="{DynamicResource TextMuted}" Margin="0,8,20,0"/></StackPanel></DockPanel>
   <Border Grid.Row="1" Background="{DynamicResource StatusBackground}" CornerRadius="6" Padding="14" Margin="0,22,0,22"><TextBlock x:Name="Status" Text="Подключаемся к серверу…" Foreground="{DynamicResource StatusText}"/></Border>
   <Grid x:Name="HomePage" Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Card}" VerticalAlignment="Top"><StackPanel><TextBlock Text="01 / ЭТО УСТРОЙСТВО" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock x:Name="DeviceNameText" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,25"/><TextBlock Text="Постоянный ID" Foreground="{DynamicResource TextMuted}"/><TextBlock x:Name="DeviceIdText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,6,0,12"/><Button x:Name="CopyButton" Content="Копировать ID" IsEnabled="False" Click="CopyId_Click" Background="{DynamicResource SecondaryButton}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Left"/><Border Height="1" Background="{DynamicResource Divider}" Margin="0,24"/><TextBlock Text="Временный код" Foreground="{DynamicResource TextMuted}"/><TextBlock x:Name="RotatingCodeText" Text="—" FontSize="34" FontWeight="SemiBold" Margin="0,6"/><TextBlock x:Name="ExpiryText" Text="Код появится после регистрации" Foreground="{DynamicResource TextMuted}"/><TextBlock Text="Передайте код человеку, которому доверяете. Каждый обычный запрос требует вашего подтверждения. Во время трансляции доступна кнопка остановки." Foreground="{DynamicResource TextMuted}" Margin="0,24,0,0" FontSize="13"/></StackPanel></Border>
    <StackPanel Grid.Column="2"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="02 / ДРУГОЕ УСТРОЙСТВО" Foreground="{DynamicResource TextMuted}" FontSize="11"/><TextBlock Text="Запросить доступ" FontSize="23" FontWeight="SemiBold" Margin="0,12,0,10"/><TextBlock Text="Введите шестизначный временный код владельца." Foreground="{DynamicResource TextMuted}" Margin="0,0,0,20"/><TextBlock Text="Код устройства" Margin="0,0,0,6"/><TextBox x:Name="ConnectionCode" MaxLength="6" FontSize="25" AutomationProperties.Name="Временный код другого устройства"/><Button x:Name="ConnectButton" Content="Отправить запрос →" Click="Connect_Click" Margin="0,14,0,0" IsEnabled="False"/></StackPanel></Border><Border Style="{StaticResource Card}" Margin="0,20,0,0" Background="{DynamicResource SurfaceAlternate}"><StackPanel><TextBlock Text="Удалённая работа" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Просмотр основного экрана и управление мышью и клавиатурой Windows. Владелец подтверждает каждый сеанс и может остановить доступ." Foreground="{DynamicResource TextMuted}" Margin="0,10,0,0"/></StackPanel></Border></StackPanel>
   </Grid>
   <StackPanel x:Name="RequestsPage" Grid.Row="2" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Входящие запросы" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Разрешение открывает трансляцию экрана и управление мышью и клавиатурой." Foreground="{DynamicResource TextMuted}" Margin="0,8,0,16"/><ListBox x:Name="RequestsList" MinHeight="130" DisplayMemberPath="Label"/><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="Разрешить" Tag="approve" Click="Respond_Click"/><Button Content="Отклонить" Tag="reject" Click="Respond_Click" Margin="12,0" Background="{DynamicResource SecondaryButton}" Foreground="{DynamicResource Accent}"/></StackPanel><TextBlock x:Name="RequestsEmpty" Text="Новых запросов нет" Foreground="{DynamicResource TextMuted}" Margin="0,15,0,0"/></StackPanel></Border></StackPanel>
   <Border x:Name="HistoryPage" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed"><StackPanel><TextBlock Text="События текущего запуска" FontSize="22" Margin="0,0,0,16"/><ListBox x:Name="HistoryList" MinHeight="240" BorderThickness="0"/></StackPanel></Border>
   <Border x:Name="SettingsPage" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed" VerticalAlignment="Top"><StackPanel><CheckBox x:Name="DarkThemeToggle" Content="Тёмная тема" Margin="0,0,0,24" Checked="Theme_Changed" Unchecked="Theme_Changed"/><TextBlock Text="Сервер координации" FontSize="22"/><TextBlock Text="HTTPS для внешнего сервера. HTTP разрешён только на этом компьютере." Foreground="{DynamicResource TextMuted}" Margin="0,10,0,20"/><TextBox x:Name="ServerAddress" Text="https://anydesk.familyserver.su" AutomationProperties.Name="Адрес сервера"/><Button x:Name="SaveButton" Content="Применить и подключиться" Click="SaveSettings_Click" Margin="0,16,0,0" HorizontalAlignment="Left"/><TextBlock Text="Сервер хранит регистрацию в памяти. При его перезапуске устройство регистрируется заново. Секрет устройства хранится только в памяти клиента." Foreground="{DynamicResource TextMuted}" Margin="0,22,0,0"/></StackPanel></Border>
  </Grid></ScrollViewer>
 </Grid>
</Window>
