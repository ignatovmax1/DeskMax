<Window x:Class="DeskMax.Windows.RemoteWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskMax — удалённый экран" Width="1100" Height="740" MinWidth="420" MinHeight="240" Background="#F4F5F2" FontFamily="Segoe UI" Loaded="Window_Loaded" Closing="Window_Closing" Deactivated="Window_Deactivated" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#20392D" Padding="18,14"><DockPanel LastChildFill="True">
   <Button x:Name="StopButton" DockPanel.Dock="Right" Content="Завершить сеанс" Background="#AB3D35" Foreground="White" Padding="16,10" BorderThickness="0" Click="Stop_Click"/>
   <StackPanel><TextBlock x:Name="SessionTitle" Text="Удалённый экран" Foreground="White" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="StateText" Text="Соединяемся…" Foreground="#C9DCCF" Margin="0,5,15,0" TextWrapping="Wrap"/></StackPanel>
  </DockPanel></Border>
  <Grid x:Name="ViewerArea" Grid.Row="1" Background="#18201B" ClipToBounds="True">
   <Image x:Name="RemoteImage" Stretch="Uniform" Focusable="True" Cursor="Cross" MouseMove="Image_MouseMove" MouseDown="Image_MouseDown" MouseUp="Image_MouseUp" MouseWheel="Image_MouseWheel" PreviewKeyDown="Image_KeyDown" PreviewKeyUp="Image_KeyUp" LostKeyboardFocus="Image_LostFocus" AutomationProperties.Name="Удалённый рабочий стол"/>
   <TextBlock x:Name="WaitingText" Text="Ожидаем первый кадр…" Foreground="#C9DCCF" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel x:Name="HostArea" Grid.Row="1" Visibility="Collapsed" Margin="20"><TextBlock Text="Ваш экран виден участнику сеанса" FontSize="20" Foreground="#20392D" FontWeight="SemiBold"/><TextBlock Text="Разрешены мышь и клавиатура. Для немедленной остановки нажмите «Завершить сеанс» или Ctrl+Alt+F12." Foreground="#465849" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel>
  <Border Grid.Row="2" Padding="16,10" Background="#E7ECE5"><DockPanel><CheckBox x:Name="ControlEnabled" DockPanel.Dock="Right" Content="Управлять мышью и клавиатурой" IsChecked="True" Checked="Control_Changed" Unchecked="Control_Changed" Margin="15,0,0,0"/><TextBlock x:Name="HelpText" Text="Основной монитор · нажмите на изображение для ввода · передача через HTTPS-сервер" Foreground="#465849" TextWrapping="Wrap"/></DockPanel></Border>
 </Grid>
</Window>
